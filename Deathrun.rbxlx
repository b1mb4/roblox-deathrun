    </Properties>
    <Item class="Script" referent="8">
      <Properties>
        <string name="Name">Main</string>
        <token name="RunContext">0</token>
        <string name="Source"><![CDATA[--!strict
--[[
    Main.server.luau
    Server entry point for Roblox Deathrun.
    Initializes all core architecture services in strict dependency order:
    1. NetworkService (RemoteEvents)
    2. ScoringService (Leaderstats & rewards)
    3. CheckpointService (Runner checkpoint progression)
    4. PlayerStateService (Lobby / Runner / TrapController state management)
    5. TrapService (Shared cooldowns & physical hazard execution)
    6. RoundService (Round lifecycle, win conditions & timer)
    7. MapService (Map creation, spawns, and triggers)
]]

local ServerScriptService = game:GetService("ServerScriptService")
local Services = ServerScriptService:WaitForChild("Services")

local NetworkService = require(Services:WaitForChild("NetworkService"))
local ScoringService = require(Services:WaitForChild("ScoringService"))
local CheckpointService = require(Services:WaitForChild("CheckpointService"))
local PlayerStateService = require(Services:WaitForChild("PlayerStateService"))
local TrapService = require(Services:WaitForChild("TrapService"))
local RoundService = require(Services:WaitForChild("RoundService"))
local MapService = require(Services:WaitForChild("MapService"))

print("[RobloxDeathrun] Starting server initialization...")

-- Step 1: Initialize Network Remotes
NetworkService.Init()

-- Step 2: Initialize Scoring & Leaderstats
ScoringService.Init()

-- Step 3: Wire CheckpointService
CheckpointService.Init({
    NetworkService = NetworkService,
    ScoringService = ScoringService,
    PlayerStateService = PlayerStateService,
})

-- Step 4: Wire PlayerStateService
PlayerStateService.Init({
    NetworkService = NetworkService,
    ScoringService = ScoringService,
    RoundService = RoundService,
    TrapService = TrapService,
})

-- Step 5: Wire TrapService
TrapService.Init({
    NetworkService = NetworkService,
    PlayerStateService = PlayerStateService,
    RoundService = RoundService,
})

-- Step 6: Wire RoundService
RoundService.Init({
    NetworkService = NetworkService,
    PlayerStateService = PlayerStateService,
    TrapService = TrapService,
    ScoringService = ScoringService,
    CheckpointService = CheckpointService,
})

-- Step 7: Wire MapService
MapService.Init({
    RoundService = RoundService,
    CheckpointService = CheckpointService,
    TrapService = TrapService,
})

print("[RobloxDeathrun] Server initialization completed successfully! Deathrun round manager is online.")
]]></string>
      </Properties>
    </Item>
    <Item class="Folder" referent="9">
      <Properties>
        <string name="Name">Services</string>
      </Properties>
      <Item class="ModuleScript" referent="10">
        <Properties>
          <string name="Name">CheckpointService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    CheckpointService.luau
    Authoritative server-side checkpoint progression for runners.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Enums = require(Shared:WaitForChild("Enums"))

local CheckpointService = {}

local highestCheckpoint: { [Player]: number } = {}
local NetworkService: any
local ScoringService: any
local PlayerStateService: any

function CheckpointService.Init(deps: { NetworkService: any, ScoringService: any, PlayerStateService: any })
    NetworkService = deps.NetworkService
    ScoringService = deps.ScoringService
    PlayerStateService = deps.PlayerStateService
end

function CheckpointService.OnCheckpointTouched(player: Player, checkpointIndex: number, padPart: BasePart)
    if not PlayerStateService or PlayerStateService.GetPlayerState(player) ~= Enums.PlayerState.Runner then
        return
    end

    local current = highestCheckpoint[player] or 0
    if checkpointIndex > current then
        highestCheckpoint[player] = checkpointIndex
        ScoringService.AddPoints(player, GameConfig.Points.Checkpoint)

        NetworkService.FireClient(player, "CheckpointReached", checkpointIndex)
        NetworkService.FireClient(player, "Announcement", 
            string.format("CHECKPOINT %d REACHED!", checkpointIndex), 
            string.format("+%d Points", GameConfig.Points.Checkpoint), 
            Color3.fromRGB(80, 255, 120), 
            "Checkpoint"
        )

        -- Visual effect on checkpoint pad
        task.spawn(function()
            local originalColor = padPart.Color
            padPart.Color = Color3.fromRGB(0, 255, 100)
            padPart.Material = Enum.Material.Neon
            task.wait(1.5)
            padPart.Color = originalColor
        end)
    end
end

function CheckpointService.GetPlayerCheckpoint(player: Player): number
    return highestCheckpoint[player] or 0
end

function CheckpointService.ResetCheckpoints()
    table.clear(highestCheckpoint)
end

function CheckpointService.OnPlayerRemoving(player: Player)
    highestCheckpoint[player] = nil
end

return CheckpointService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="11">
        <Properties>
          <string name="Name">MapService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    MapService.luau
    Builds and wires the complete Deathrun 3D map:
    - Lobby, Runner Course, Elevated Controller Catwalk, Checkpoints, Finish, KillZone
    - 6 Functional Traps: CollapsingBridge, SwingingHammer, FallingCeiling, MovingWall, RotatingPlatform, Pitfall
    - Physical 3D controller terminals with ClickDetectors
    - Finish detection & KillZone lethal triggers
]]

local Workspace = game:GetService("Workspace")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local TrapConfig = require(Shared:WaitForChild("TrapConfig"))

local MapService = {}

local RoundService: any
local CheckpointService: any
local TrapService: any

function MapService.Init(deps: {
    RoundService: any,
    CheckpointService: any,
    TrapService: any,
})
    RoundService = deps.RoundService
    CheckpointService = deps.CheckpointService
    TrapService = deps.TrapService

    local mapFolder = Workspace:FindFirstChild("Map")
    if not mapFolder then
        mapFolder = MapService.BuildMap()
    end

    MapService.WireMapTriggers(mapFolder)
end

function MapService.CreatePart(parent: Instance, name: string, size: Vector3, cframe: CFrame, color: Color3, material: Enum.Material, anchored: boolean, canCollide: boolean): Part
    local part = Instance.new("Part")
    part.Name = name
    part.Size = size
    part.CFrame = cframe
    part.Color = color
    part.Material = material
    part.Anchored = anchored ~= nil and anchored or true
    part.CanCollide = canCollide ~= nil and canCollide or true
    part.TopSurface = Enum.SurfaceType.Smooth
    part.BottomSurface = Enum.SurfaceType.Smooth
    part.Parent = parent
    return part
end

function MapService.BuildMap(): Folder
    local map = Instance.new("Folder")
    map.Name = "Map"
    map.Parent = Workspace

    -- ==================== 1. LOBBY ====================
    local lobby = Instance.new("Folder")
    lobby.Name = "Lobby"
    lobby.Parent = map

    -- Lobby floor (high above, looking down on the course)
    MapService.CreatePart(lobby, "Floor", Vector3.new(50, 4, 50), CFrame.new(0, 50, -80), Color3.fromRGB(30, 32, 40), Enum.Material.Metal, true, true)
    -- Lobby walls (glass front looking over course)
    MapService.CreatePart(lobby, "WallBack", Vector3.new(50, 16, 2), CFrame.new(0, 60, -105), Color3.fromRGB(20, 22, 28), Enum.Material.SmoothPlastic, true, true)
    MapService.CreatePart(lobby, "WallLeft", Vector3.new(2, 16, 50), CFrame.new(-25, 60, -80), Color3.fromRGB(20, 22, 28), Enum.Material.SmoothPlastic, true, true)
    MapService.CreatePart(lobby, "WallRight", Vector3.new(2, 16, 50), CFrame.new(25, 60, -80), Color3.fromRGB(20, 22, 28), Enum.Material.SmoothPlastic, true, true)
    -- Glass front wall
    local glassWall = MapService.CreatePart(lobby, "WallFrontGlass", Vector3.new(50, 16, 1), CFrame.new(0, 60, -55), Color3.fromRGB(180, 220, 255), Enum.Material.Glass, true, true)
    glassWall.Transparency = 0.7

    -- Lobby Spawn
    local lobbySpawn = Instance.new("SpawnLocation")
    lobbySpawn.Name = "LobbySpawn"
    lobbySpawn.Size = Vector3.new(12, 1, 12)
    lobbySpawn.CFrame = CFrame.new(0, 52.5, -80)
    lobbySpawn.Color = Color3.fromRGB(0, 170, 255)
    lobbySpawn.Material = Enum.Material.Neon
    lobbySpawn.Anchored = true
    lobbySpawn.CanCollide = true
    lobbySpawn.Neutral = true
    lobbySpawn.Parent = lobby

    -- ==================== 2. RUNNER START ====================
    local runnerStart = Instance.new("Folder")
    runnerStart.Name = "RunnerStart"
    runnerStart.Parent = map

    MapService.CreatePart(runnerStart, "Floor", Vector3.new(30, 4, 30), CFrame.new(0, 10, 10), Color3.fromRGB(45, 50, 60), Enum.Material.DiamondPlate, true, true)

    local runnerSpawn = Instance.new("SpawnLocation")
    runnerSpawn.Name = "RunnerSpawn"
    runnerSpawn.Size = Vector3.new(10, 1, 10)
    runnerSpawn.CFrame = CFrame.new(0, 12.5, 10)
    runnerSpawn.Color = Color3.fromRGB(80, 255, 120)
    runnerSpawn.Material = Enum.Material.Neon
    runnerSpawn.Anchored = true
    runnerSpawn.CanCollide = true
    runnerSpawn.Enabled = false
    runnerSpawn.Parent = runnerStart

    -- Barrier gate that drops on round start
    local barrier = MapService.CreatePart(runnerStart, "Barrier", Vector3.new(30, 12, 2), CFrame.new(0, 18, 25), Color3.fromRGB(255, 50, 50), Enum.Material.ForceField, true, true)
    barrier.Transparency = 0.4

    -- ==================== 3. TRAP CONTROLLER WALKWAY ====================
    -- Elevated parallel catwalk running along the entire course with glass observation windows
    local controllerArea = Instance.new("Folder")
    controllerArea.Name = "TrapControllerArea"
    controllerArea.Parent = map

    -- Walkway floor (X = 38, Y = 25, Z = 20 to 480)
    MapService.CreatePart(controllerArea, "WalkwayFloor", Vector3.new(16, 2, 480), CFrame.new(38, 25, 250), Color3.fromRGB(35, 40, 50), Enum.Material.Metal, true, true)
    -- Glass railing facing runner course
    local railing = MapService.CreatePart(controllerArea, "GlassRailing", Vector3.new(1, 10, 480), CFrame.new(30, 31, 250), Color3.fromRGB(150, 220, 255), Enum.Material.Glass, true, true)
    railing.Transparency = 0.75
    -- Back wall
    MapService.CreatePart(controllerArea, "BackWall", Vector3.new(1, 14, 480), CFrame.new(46, 33, 250), Color3.fromRGB(20, 25, 30), Enum.Material.SmoothPlastic, true, true)

    -- Controller Spawn
    local controllerSpawn = Instance.new("SpawnLocation")
    controllerSpawn.Name = "ControllerSpawn"
    controllerSpawn.Size = Vector3.new(8, 1, 8)
    controllerSpawn.CFrame = CFrame.new(38, 26.5, 25)
    controllerSpawn.Color = Color3.fromRGB(255, 60, 60)
    controllerSpawn.Material = Enum.Material.Neon
    controllerSpawn.Anchored = true
    controllerSpawn.CanCollide = true
    controllerSpawn.Enabled = false
    controllerSpawn.Parent = controllerArea

    -- ==================== 4. TRAPS & COURSE SECTIONS ====================
    local trapsFolder = Instance.new("Folder")
    trapsFolder.Name = "Traps"
    trapsFolder.Parent = map

    local courseFolder = Instance.new("Folder")
    courseFolder.Name = "RunnerCourse"
    courseFolder.Parent = map

    -- Pre-Trap 1: Jumps
    MapService.CreatePart(courseFolder, "JumpPad1", Vector3.new(8, 2, 8), CFrame.new(-4, 10, 38), Color3.fromRGB(50, 55, 65), Enum.Material.DiamondPlate, true, true)
    MapService.CreatePart(courseFolder, "JumpPad2", Vector3.new(8, 2, 8), CFrame.new(4, 10, 50), Color3.fromRGB(50, 55, 65), Enum.Material.DiamondPlate, true, true)

    -- ---------- TRAP 1: COLLAPSING BRIDGE (Z = 65) ----------
    local bridgeModel = Instance.new("Model")
    bridgeModel.Name = "CollapsingBridge"
    bridgeModel.Parent = trapsFolder

    local pillars = Instance.new("Folder")
    pillars.Name = "WarningPillars"
    pillars.Parent = bridgeModel
    MapService.CreatePart(pillars, "PillarLeft", Vector3.new(3, 12, 3), CFrame.new(-10, 16, 65), Color3.fromRGB(60, 60, 60), Enum.Material.SmoothPlastic, true, true)
    MapService.CreatePart(pillars, "PillarRight", Vector3.new(3, 12, 3), CFrame.new(10, 16, 65), Color3.fromRGB(60, 60, 60), Enum.Material.SmoothPlastic, true, true)

    local planks = Instance.new("Folder")
    planks.Name = "Planks"
    planks.Parent = bridgeModel
    MapService.CreatePart(planks, "Plank1", Vector3.new(14, 2, 8), CFrame.new(0, 10, 60), Color3.fromRGB(80, 85, 95), Enum.Material.DiamondPlate, true, true)
    MapService.CreatePart(planks, "Plank2", Vector3.new(14, 2, 8), CFrame.new(0, 10, 70), Color3.fromRGB(80, 85, 95), Enum.Material.DiamondPlate, true, true)
    MapService.CreatePart(planks, "Plank3", Vector3.new(14, 2, 8), CFrame.new(0, 10, 80), Color3.fromRGB(80, 85, 95), Enum.Material.DiamondPlate, true, true)

    -- CHECKPOINT 1 ISLAND (Z = 100)
    local cp1 = Instance.new("Model")
    cp1.Name = "Checkpoint1"
    cp1.Parent = map
    MapService.CreatePart(cp1, "Island", Vector3.new(20, 4, 16), CFrame.new(0, 10, 100), Color3.fromRGB(40, 45, 55), Enum.Material.Metal, true, true)
    local pad1 = MapService.CreatePart(cp1, "Pad", Vector3.new(10, 1, 10), CFrame.new(0, 12.5, 100), Color3.fromRGB(0, 200, 100), Enum.Material.Neon, true, true)
    pad1:SetAttribute("CheckpointIndex", 1)

    -- Course Catwalk to Trap 2
    MapService.CreatePart(courseFolder, "NarrowBeam", Vector3.new(6, 2, 24), CFrame.new(0, 10, 120), Color3.fromRGB(50, 55, 65), Enum.Material.DiamondPlate, true, true)

    -- ---------- TRAP 2: SWINGING HAMMER (Z = 140) ----------
    local hammerModel = Instance.new("Model")
    hammerModel.Name = "SwingingHammer"
    hammerModel.Parent = trapsFolder

    local arch = Instance.new("Folder")
    arch.Name = "Arch"
    arch.Parent = hammerModel
    MapService.CreatePart(arch, "LegL", Vector3.new(3, 26, 3), CFrame.new(-12, 23, 140), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, true, true)
    MapService.CreatePart(arch, "LegR", Vector3.new(3, 26, 3), CFrame.new(12, 23, 140), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, true, true)
    MapService.CreatePart(arch, "TopCross", Vector3.new(27, 3, 3), CFrame.new(0, 36, 140), Color3.fromRGB(50, 50, 55), Enum.Material.Metal, true, true)
    local beaconH = MapService.CreatePart(arch, "BeaconHammer", Vector3.new(2, 2, 2), CFrame.new(0, 38, 140), Color3.fromRGB(255, 170, 0), Enum.Material.Neon, true, true)

    local pivot = MapService.CreatePart(hammerModel, "Pivot", Vector3.new(2, 2, 2), CFrame.new(0, 35, 140), Color3.fromRGB(80, 80, 80), Enum.Material.Metal, true, false)
    pivot.Transparency = 1

    local hammerObj = Instance.new("Model")
    hammerObj.Name = "Hammer"
    hammerObj.Parent = hammerModel
    local pole = MapService.CreatePart(hammerObj, "Pole", Vector3.new(2, 20, 2), CFrame.new(0, 24, 140), Color3.fromRGB(70, 70, 75), Enum.Material.Metal, true, false)
    local head = MapService.CreatePart(hammerObj, "Head", Vector3.new(10, 5, 5), CFrame.new(0, 14, 140), Color3.fromRGB(240, 60, 60), Enum.Material.DiamondPlate, true, true)
    hammerObj.PrimaryPart = pole

    MapService.CreatePart(courseFolder, "HammerWalkway", Vector3.new(8, 2, 30), CFrame.new(0, 10, 140), Color3.fromRGB(50, 55, 65), Enum.Material.DiamondPlate, true, true)

    -- CHECKPOINT 2 ISLAND (Z = 180)
    local cp2 = Instance.new("Model")
    cp2.Name = "Checkpoint2"
    cp2.Parent = map
    MapService.CreatePart(cp2, "Island", Vector3.new(20, 4, 16), CFrame.new(0, 10, 180), Color3.fromRGB(40, 45, 55), Enum.Material.Metal, true, true)
    local pad2 = MapService.CreatePart(cp2, "Pad", Vector3.new(10, 1, 10), CFrame.new(0, 12.5, 180), Color3.fromRGB(0, 200, 100), Enum.Material.Neon, true, true)
    pad2:SetAttribute("CheckpointIndex", 2)

    -- ---------- TRAP 3: FALLING CEILING (Z = 225) ----------
    local ceilingModel = Instance.new("Model")
    ceilingModel.Name = "FallingCeiling"
    ceilingModel.Parent = trapsFolder

    -- Tunnel enclosure
    MapService.CreatePart(ceilingModel, "TunnelFloor", Vector3.new(14, 2, 40), CFrame.new(0, 10, 225), Color3.fromRGB(40, 40, 45), Enum.Material.DiamondPlate, true, true)
    MapService.CreatePart(ceilingModel, "TunnelWallL", Vector3.new(2, 20, 40), CFrame.new(-8, 20, 225), Color3.fromRGB(30, 30, 35), Enum.Material.Metal, true, true)
    MapService.CreatePart(ceilingModel, "TunnelWallR", Vector3.new(2, 20, 40), CFrame.new(8, 20, 225), Color3.fromRGB(30, 30, 35), Enum.Material.Metal, true, true)
    MapService.CreatePart(ceilingModel, "TunnelRoof", Vector3.new(18, 2, 40), CFrame.new(0, 31, 225), Color3.fromRGB(30, 30, 35), Enum.Material.Metal, true, true)

    local warningLights = Instance.new("Folder")
    warningLights.Name = "WarningLights"
    warningLights.Parent = ceilingModel
    MapService.CreatePart(warningLights, "Light1", Vector3.new(14, 1, 1), CFrame.new(0, 30, 210), Color3.fromRGB(50, 50, 50), Enum.Material.SmoothPlastic, true, false)
    MapService.CreatePart(warningLights, "Light2", Vector3.new(14, 1, 1), CFrame.new(0, 30, 240), Color3.fromRGB(50, 50, 50), Enum.Material.SmoothPlastic, true, false)

    -- Crusher slab suspended at ceiling Y = 28
    MapService.CreatePart(ceilingModel, "Crusher", Vector3.new(12, 3, 34), CFrame.new(0, 28, 225), Color3.fromRGB(220, 40, 40), Enum.Material.DiamondPlate, true, true)

    -- Course Catwalk to Trap 4
    MapService.CreatePart(courseFolder, "CatwalkMid", Vector3.new(10, 2, 24), CFrame.new(0, 10, 262), Color3.fromRGB(50, 55, 65), Enum.Material.Metal, true, true)

    -- ---------- TRAP 4: MOVING WALL (Z = 290) ----------
    local wallModel = Instance.new("Model")
    wallModel.Name = "MovingWall"
    wallModel.Parent = trapsFolder

    MapService.CreatePart(wallModel, "Walkway", Vector3.new(12, 2, 26), CFrame.new(0, 10, 290), Color3.fromRGB(50, 55, 65), Enum.Material.DiamondPlate, true, true)
    MapService.CreatePart(wallModel, "SideHousing", Vector3.new(4, 16, 26), CFrame.new(-14, 18, 290), Color3.fromRGB(35, 40, 45), Enum.Material.Metal, true, true)
    local sign = MapService.CreatePart(wallModel, "WarningSign", Vector3.new(1, 4, 12), CFrame.new(-11.9, 18, 290), Color3.fromRGB(50, 50, 50), Enum.Material.SmoothPlastic, true, false)

    -- Battering pusher wall recessed at X = -11
    MapService.CreatePart(wallModel, "Pusher", Vector3.new(4, 10, 22), CFrame.new(-11, 16, 290), Color3.fromRGB(0, 170, 255), Enum.Material.Metal, true, true)

    -- CHECKPOINT 3 ISLAND (Z = 330)
    local cp3 = Instance.new("Model")
    cp3.Name = "Checkpoint3"
    cp3.Parent = map
    MapService.CreatePart(cp3, "Island", Vector3.new(20, 4, 16), CFrame.new(0, 10, 330), Color3.fromRGB(40, 45, 55), Enum.Material.Metal, true, true)
    local pad3 = MapService.CreatePart(cp3, "Pad", Vector3.new(10, 1, 10), CFrame.new(0, 12.5, 330), Color3.fromRGB(0, 200, 100), Enum.Material.Neon, true, true)
    pad3:SetAttribute("CheckpointIndex", 3)

    -- Island Hops to Trap 5
    MapService.CreatePart(courseFolder, "Hop1", Vector3.new(6, 2, 6), CFrame.new(-3, 10, 348), Color3.fromRGB(50, 55, 65), Enum.Material.DiamondPlate, true, true)
    MapService.CreatePart(courseFolder, "Hop2", Vector3.new(6, 2, 6), CFrame.new(3, 10, 360), Color3.fromRGB(50, 55, 65), Enum.Material.DiamondPlate, true, true)

    -- ---------- TRAP 5: ROTATING PLATFORM (Z = 375) ----------
    local rotModel = Instance.new("Model")
    rotModel.Name = "RotatingPlatform"
    rotModel.Parent = trapsFolder

    local spinPad = MapService.CreatePart(rotModel, "SpinPlatform", Vector3.new(16, 2, 16), CFrame.new(0, 10, 375), Color3.fromRGB(150, 60, 220), Enum.Material.DiamondPlate, true, true)

    local beacons = Instance.new("Folder")
    beacons.Name = "Beacons"
    beacons.Parent = rotModel
    MapService.CreatePart(beacons, "B1", Vector3.new(2, 4, 2), CFrame.new(-10, 12, 375), Color3.fromRGB(50, 50, 50), Enum.Material.SmoothPlastic, true, true)
    MapService.CreatePart(beacons, "B2", Vector3.new(2, 4, 2), CFrame.new(10, 12, 375), Color3.fromRGB(50, 50, 50), Enum.Material.SmoothPlastic, true, true)

    -- Runway to Trap 6
    MapService.CreatePart(courseFolder, "FinalRunway", Vector3.new(12, 2, 30), CFrame.new(0, 10, 405), Color3.fromRGB(45, 50, 60), Enum.Material.Metal, true, true)

    -- ---------- TRAP 6: PITFALL (Z = 445) ----------
    local pitModel = Instance.new("Model")
    pitModel.Name = "Pitfall"
    pitModel.Parent = trapsFolder

    MapService.CreatePart(pitModel, "PitFrameL", Vector3.new(2, 2, 32), CFrame.new(-7, 10, 445), Color3.fromRGB(30, 35, 40), Enum.Material.Metal, true, true)
    MapService.CreatePart(pitModel, "PitFrameR", Vector3.new(2, 2, 32), CFrame.new(7, 10, 445), Color3.fromRGB(30, 35, 40), Enum.Material.Metal, true, true)

    local warningFrame = Instance.new("Folder")
    warningFrame.Name = "WarningFrame"
    warningFrame.Parent = pitModel
    MapService.CreatePart(warningFrame, "EdgeL", Vector3.new(1, 1, 32), CFrame.new(-6.5, 11.2, 445), Color3.fromRGB(50, 50, 50), Enum.Material.SmoothPlastic, true, false)
    MapService.CreatePart(warningFrame, "EdgeR", Vector3.new(1, 1, 32), CFrame.new(6.5, 11.2, 445), Color3.fromRGB(50, 50, 50), Enum.Material.SmoothPlastic, true, false)

    -- Dual trapdoors
    MapService.CreatePart(pitModel, "HatchLeft", Vector3.new(6, 2, 30), CFrame.new(-3, 10, 445), Color3.fromRGB(70, 75, 85), Enum.Material.DiamondPlate, true, true)
    MapService.CreatePart(pitModel, "HatchRight", Vector3.new(6, 2, 30), CFrame.new(3, 10, 445), Color3.fromRGB(70, 75, 85), Enum.Material.DiamondPlate, true, true)

    -- ==================== 5. FINISH PLATFORM (Z = 490) ====================
    local finish = Instance.new("Model")
    finish.Name = "Finish"
    finish.Parent = map

    MapService.CreatePart(finish, "Floor", Vector3.new(30, 4, 30), CFrame.new(0, 10, 490), Color3.fromRGB(40, 50, 60), Enum.Material.DiamondPlate, true, true)

    -- Golden victory arch
    MapService.CreatePart(finish, "ArchL", Vector3.new(3, 16, 3), CFrame.new(-12, 20, 485), Color3.fromRGB(255, 215, 0), Enum.Material.Neon, true, true)
    MapService.CreatePart(finish, "ArchR", Vector3.new(3, 16, 3), CFrame.new(12, 20, 485), Color3.fromRGB(255, 215, 0), Enum.Material.Neon, true, true)
    MapService.CreatePart(finish, "ArchTop", Vector3.new(27, 3, 3), CFrame.new(0, 28, 485), Color3.fromRGB(255, 215, 0), Enum.Material.Neon, true, true)

    -- Finish Pad
    local finishPad = MapService.CreatePart(finish, "FinishPad", Vector3.new(14, 1, 14), CFrame.new(0, 12.5, 490), Color3.fromRGB(255, 215, 0), Enum.Material.Neon, true, true)

    -- ==================== 6. PHYSICAL CONTROLLER BUTTONS ====================
    -- Place physical 3D console buttons on the controller walkway overlooking each trap
    local trapZPositions = {
        CollapsingBridge = 65,
        SwingingHammer = 140,
        FallingCeiling = 225,
        MovingWall = 290,
        RotatingPlatform = 375,
        Pitfall = 445,
    }

    for trapId, zPos in pairs(trapZPositions) do
        local console = Instance.new("Model")
        console.Name = "Console_" .. trapId
        console.Parent = controllerArea

        -- Console pedestal
        MapService.CreatePart(console, "Stand", Vector3.new(2, 4, 3), CFrame.new(32, 28, zPos), Color3.fromRGB(30, 30, 35), Enum.Material.Metal, true, true)
        -- Red activation button
        local button = MapService.CreatePart(console, "Button", Vector3.new(1.2, 0.6, 1.2), CFrame.new(32, 30.3, zPos), Color3.fromRGB(255, 30, 30), Enum.Material.Neon, true, true)
        button:SetAttribute("TrapId", trapId)

        local clickDetector = Instance.new("ClickDetector")
        clickDetector.MaxActivationDistance = 14
        clickDetector.Parent = button

        clickDetector.MouseClick:Connect(function(player: Player)
            if TrapService then
                TrapService.RequestTrapActivation(player, trapId)
            end
        end)
    end

    -- ==================== 7. KILLZONE ====================
    local killZone = Instance.new("Part")
    killZone.Name = "KillZone"
    killZone.Size = Vector3.new(1000, 4, 1000)
    killZone.CFrame = CFrame.new(0, GameConfig.Coordinates.KillZoneY, 200)
    killZone.Color = Color3.fromRGB(255, 0, 0)
    killZone.Material = Enum.Material.Neon
    killZone.Transparency = 0.5
    killZone.Anchored = true
    killZone.CanCollide = false
    killZone.Parent = map

    return map
end

function MapService.WireMapTriggers(map: Folder)
    -- Wire Checkpoint pads
    for i = 1, 3 do
        local cpModel = map:FindFirstChild("Checkpoint" .. i)
        local pad = cpModel and cpModel:FindFirstChild("Pad") :: BasePart?
        if pad then
            pad.Touched:Connect(function(hit)
                local char = hit.Parent
                local player = char and Players:GetPlayerFromCharacter(char)
                if player and CheckpointService then
                    CheckpointService.OnCheckpointTouched(player, i, pad)
                end
            end)
        end
    end

    -- Wire Finish Pad
    local finish = map:FindFirstChild("Finish")
    local finishPad = finish and finish:FindFirstChild("FinishPad") :: BasePart?
    if finishPad then
        finishPad.Touched:Connect(function(hit)
            local char = hit.Parent
            local player = char and Players:GetPlayerFromCharacter(char)
            if player and RoundService then
                RoundService.OnRunnerFinished(player)
            end
        end)
    end

    -- Wire KillZone
    local killZone = map:FindFirstChild("KillZone") :: BasePart?
    if killZone then
        killZone.Touched:Connect(function(hit)
            local char = hit.Parent
            local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
            if hum and hum.Health > 0 then
                hum:TakeDamage(1000)
            end
        end)
    end

    -- Register traps for reset tracking
    local trapsFolder = map:FindFirstChild("Traps")
    if trapsFolder and TrapService then
        for _, trapModel in ipairs(trapsFolder:GetChildren()) do
            if trapModel:IsA("Model") then
                TrapService.RegisterTrapParts(trapModel.Name, trapModel)
            end
        end
    end
end

return MapService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="12">
        <Properties>
          <string name="Name">NetworkService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    NetworkService.luau
    Manages client-server communication channels and RemoteEvents.
]]

local ReplicatedStorage = game:GetService("ReplicatedStorage")

local NetworkService = {}
local RemotesFolder: Folder

local REMOTE_EVENTS = {
    "ActivateTrap",
    "TrapStateChanged",
    "PlayerStateChanged",
    "RoundStateChanged",
    "Announcement",
    "CheckpointReached",
    "DevToggleRole",
}

function NetworkService.Init()
    local existing = ReplicatedStorage:FindFirstChild("Remotes")
    if existing and existing:IsA("Folder") then
        RemotesFolder = existing
    else
        RemotesFolder = Instance.new("Folder")
        RemotesFolder.Name = "Remotes"
        RemotesFolder.Parent = ReplicatedStorage
    end

    for _, remoteName in ipairs(REMOTE_EVENTS) do
        if not RemotesFolder:FindFirstChild(remoteName) then
            local remote = Instance.new("RemoteEvent")
            remote.Name = remoteName
            remote.Parent = RemotesFolder
        end
    end
end

function NetworkService.GetRemote(name: string): RemoteEvent
    local remote = RemotesFolder:FindFirstChild(name)
    if not remote or not remote:IsA("RemoteEvent") then
        error(string.format("RemoteEvent %s not found in Remotes folder", name))
    end
    return remote
end

function NetworkService.FireClient(player: Player, remoteName: string, ...: any)
    local remote = NetworkService.GetRemote(remoteName)
    remote:FireClient(player, ...)
end

function NetworkService.FireAllClients(remoteName: string, ...: any)
    local remote = NetworkService.GetRemote(remoteName)
    remote:FireAllClients(...)
end

function NetworkService.ConnectServerEvent(remoteName: string, callback: (player: Player, ...any) -> ())
    local remote = NetworkService.GetRemote(remoteName)
    return remote.OnServerEvent:Connect(callback)
end

return NetworkService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="13">
        <Properties>
          <string name="Name">PlayerStateService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    PlayerStateService.luau
    Authoritative server-side management of player states and team transitions:
    - Lobby -> Runner / TrapController
    - Runner Death -> Switch to TrapController & Respawn at Controller Walkway
    - Spectator handling for mid-round joins
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Enums = require(Shared:WaitForChild("Enums"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local PlayerStateService = {}

local playerStates: { [Player]: string } = {}
local aliveRunners: { [Player]: boolean } = {}
local NetworkService: any
local ScoringService: any
local RoundService: any
local TrapService: any

function PlayerStateService.Init(deps: { 
    NetworkService: any, 
    ScoringService: any, 
    RoundService: any, 
    TrapService: any 
})
    NetworkService = deps.NetworkService
    ScoringService = deps.ScoringService
    RoundService = deps.RoundService
    TrapService = deps.TrapService

    Players.PlayerAdded:Connect(function(player)
        PlayerStateService.OnPlayerAdded(player)
    end)

    Players.PlayerRemoving:Connect(function(player)
        PlayerStateService.OnPlayerRemoving(player)
    end)

    for _, player in ipairs(Players:GetPlayers()) do
        PlayerStateService.OnPlayerAdded(player)
    end

    -- Hook up DevMode role toggle
    NetworkService.ConnectServerEvent("DevToggleRole", function(player: Player)
        if not GameConfig.DevMode then return end
        local currentState = PlayerStateService.GetPlayerState(player)
        if currentState == Enums.PlayerState.Runner then
            PlayerStateService.SetPlayerState(player, Enums.PlayerState.TrapController)
            PlayerStateService.TeleportTo(player, GameConfig.Coordinates.ControllerSpawn)
            NetworkService.FireClient(player, "Announcement", "DEV ROLE SWITCHED", "You are now a Trap Controller", Color3.fromRGB(255, 100, 100))
        else
            PlayerStateService.SetPlayerState(player, Enums.PlayerState.Runner)
            aliveRunners[player] = true
            PlayerStateService.TeleportTo(player, GameConfig.Coordinates.RunnerSpawn)
            NetworkService.FireClient(player, "Announcement", "DEV ROLE SWITCHED", "You are now a Runner", Color3.fromRGB(100, 255, 100))
        end
        if RoundService and RoundService.UpdateRoundHUD then
            RoundService.UpdateRoundHUD()
        end
    end)
end

function PlayerStateService.OnPlayerAdded(player: Player)
    playerStates[player] = Enums.PlayerState.Lobby

    player.CharacterAdded:Connect(function(character)
        PlayerStateService.OnCharacterAdded(player, character)
    end)

    if player.Character then
        PlayerStateService.OnCharacterAdded(player, player.Character)
    end
end

function PlayerStateService.OnCharacterAdded(player: Player, character: Model)
    local humanoid = character:WaitForChild("Humanoid", 5) :: Humanoid?
    if not humanoid then return end

    humanoid.Died:Connect(function()
        PlayerStateService.OnCharacterDied(player, character)
    end)

    -- Teleport to appropriate spawn based on current state
    task.spawn(function()
        task.wait(0.1)
        local state = playerStates[player]
        if state == Enums.PlayerState.Runner then
            PlayerStateService.TeleportTo(player, GameConfig.Coordinates.RunnerSpawn)
        elseif state == Enums.PlayerState.TrapController then
            PlayerStateService.TeleportTo(player, GameConfig.Coordinates.ControllerSpawn)
        else
            PlayerStateService.TeleportTo(player, GameConfig.Coordinates.LobbySpawn)
        end
    end)
end

function PlayerStateService.OnCharacterDied(player: Player, _character: Model)
    local state = playerStates[player]
    if state == Enums.PlayerState.Runner then
        aliveRunners[player] = nil

        -- Check if killed by an active trap for kill attribution
        local killer = TrapService and TrapService.GetRecentTrapController()
        if killer and killer ~= player then
            ScoringService.AddKill(killer)
            ScoringService.AddPoints(killer, GameConfig.Points.TrapKill)
            NetworkService.FireClient(killer, "Announcement", 
                "RUNNER ELIMINATED!", 
                string.format("+%d Pts (Eliminated %s)", GameConfig.Points.TrapKill, player.DisplayName), 
                Color3.fromRGB(255, 200, 50), 
                "Kill"
            )
        end

        -- Broadcast elimination to all players
        NetworkService.FireAllClients("Announcement", 
            "RUNNER ELIMINATED", 
            string.format("%s fell and became a Trap Controller!", player.DisplayName), 
            Color3.fromRGB(255, 75, 75), 
            "Death"
        )

        -- Transition runner to TrapController
        PlayerStateService.SetPlayerState(player, Enums.PlayerState.TrapController)

        -- Notify RoundService of elimination
        if RoundService then
            RoundService.OnRunnerEliminated(player)
        end

        -- Respawn player at trap controller observation area after delay
        task.delay(GameConfig.DeathRespawnDelay, function()
            if player.Parent and playerStates[player] == Enums.PlayerState.TrapController then
                player:LoadCharacter()
                task.wait(0.1)
                PlayerStateService.TeleportTo(player, GameConfig.Coordinates.ControllerSpawn)
                NetworkService.FireClient(player, "Announcement", 
                    "YOU ARE NOW A TRAP CONTROLLER", 
                    "Activate traps to eliminate the remaining runners!", 
                    Color3.fromRGB(255, 100, 100), 
                    "Siren"
                )
            end
        end)
    end
end

function PlayerStateService.OnPlayerRemoving(player: Player)
    playerStates[player] = nil
    aliveRunners[player] = nil

    if RoundService then
        RoundService.OnPlayerLeft(player)
    end
end

function PlayerStateService.SetPlayerState(player: Player, state: string)
    playerStates[player] = state
    NetworkService.FireClient(player, "PlayerStateChanged", state)
end

function PlayerStateService.GetPlayerState(player: Player): string
    return playerStates[player] or Enums.PlayerState.Lobby
end

function PlayerStateService.GetActiveRunners(): { Player }
    local list = {}
    for player, isAlive in pairs(aliveRunners) do
        if isAlive and player.Parent and playerStates[player] == Enums.PlayerState.Runner then
            table.insert(list, player)
        end
    end
    return list
end

function PlayerStateService.GetTrapControllers(): { Player }
    local list = {}
    for player, state in pairs(playerStates) do
        if state == Enums.PlayerState.TrapController and player.Parent then
            table.insert(list, player)
        end
    end
    return list
end

function PlayerStateService.MarkRunnerAlive(player: Player)
    aliveRunners[player] = true
end

function PlayerStateService.ClearAliveRunners()
    table.clear(aliveRunners)
end

function PlayerStateService.TeleportTo(player: Player, position: Vector3)
    local character = player.Character
    if character then
        local root = character:FindFirstChild("HumanoidRootPart") :: BasePart?
        if root then
            root.CFrame = CFrame.new(position + Vector3.new(0, 3, 0))
        end
    end
end

return PlayerStateService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="14">
        <Properties>
          <string name="Name">RoundService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    RoundService.luau
    Authoritative server-side round lifecycle manager:
    - WaitingForPlayers -> Intermission -> Team Assignment -> InProgress -> Win Evaluation -> Results -> Reset
    - Handles disconnects, eliminations, single-runner alerts, and solo/multiplayer scaling.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Enums = require(Shared:WaitForChild("Enums"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local Types = require(Shared:WaitForChild("Types"))

local RoundService = {}

local currentRoundState: string = Enums.RoundState.WaitingForPlayers
local roundTimeRemaining: number = 0
local totalRunnersAtStart: number = 0
local lastControllerPlayer: Player? = nil
local lastRunnerAlertGiven: boolean = false
local roundLoopActive: boolean = false

local NetworkService: any
local PlayerStateService: any
local TrapService: any
local ScoringService: any
local CheckpointService: any

function RoundService.Init(deps: {
    NetworkService: any,
    PlayerStateService: any,
    TrapService: any,
    ScoringService: any,
    CheckpointService: any,
})
    NetworkService = deps.NetworkService
    PlayerStateService = deps.PlayerStateService
    TrapService = deps.TrapService
    ScoringService = deps.ScoringService
    CheckpointService = deps.CheckpointService

    -- Start background round lifecycle loop
    task.spawn(function()
        RoundService.StartRoundLoop()
    end)
end

function RoundService.IsRoundInProgress(): boolean
    return currentRoundState == Enums.RoundState.InProgress
end

function RoundService.GetRoundState(): string
    return currentRoundState
end

function RoundService.StartRoundLoop()
    if roundLoopActive then return end
    roundLoopActive = true

    while true do
        -- STEP 1: WAITING FOR PLAYERS
        currentRoundState = Enums.RoundState.WaitingForPlayers
        while #Players:GetPlayers() < GameConfig.MinPlayersToStart do
            RoundService.BroadcastRoundStatus(0)
            task.wait(1.0)
        end

        -- STEP 2: INTERMISSION
        currentRoundState = Enums.RoundState.Intermission
        for i = GameConfig.IntermissionDuration, 1, -1 do
            if #Players:GetPlayers() < GameConfig.MinPlayersToStart then
                break
            end
            RoundService.BroadcastRoundStatus(i)
            task.wait(1.0)
        end

        if #Players:GetPlayers() >= GameConfig.MinPlayersToStart then
            -- STEP 3: SETUP & START ROUND
            RoundService.SetupAndStartRound()

            -- STEP 4: ACTIVE ROUND LOOP
            while currentRoundState == Enums.RoundState.InProgress and roundTimeRemaining > 0 do
                task.wait(1.0)
                roundTimeRemaining -= 1
                RoundService.BroadcastRoundStatus(roundTimeRemaining)

                local activeRunners = PlayerStateService.GetActiveRunners()
                local runnerCount = #activeRunners

                -- Check last runner remaining announcement
                if runnerCount == 1 and totalRunnersAtStart > 1 and not lastRunnerAlertGiven then
                    lastRunnerAlertGiven = true
                    local lastRunner = activeRunners[1]
                    NetworkService.FireAllClients(
                        "Announcement",
                        "LAST RUNNER STANDING!",
                        string.format("%s is the only runner left! Survive to escape!", lastRunner.DisplayName),
                        Color3.fromRGB(255, 215, 0),
                        "LastRunner"
                    )
                end

                -- Check win condition: all runners dead
                if runnerCount == 0 then
                    RoundService.EndRound("TrapControllers", Enums.WinReason.AllRunnersEliminated)
                    break
                end
            end

            -- Check time expiration
            if currentRoundState == Enums.RoundState.InProgress and roundTimeRemaining <= 0 then
                RoundService.EndRound("TrapControllers", Enums.WinReason.TimeExpired)
            end

            -- STEP 5: RESULTS SCREEN & RESET
            task.wait(GameConfig.ResultsDuration)
            RoundService.CleanupAfterRound()
        end
    end
end

function RoundService.SetupAndStartRound()
    currentRoundState = Enums.RoundState.InProgress
    roundTimeRemaining = GameConfig.RoundDuration
    lastRunnerAlertGiven = false

    -- Reset services
    TrapService.ResetAllTraps()
    CheckpointService.ResetCheckpoints()
    ScoringService.ResetRoundRewards()
    PlayerStateService.ClearAliveRunners()

    local allPlayers = Players:GetPlayers()
    local controllers: { Player } = {}
    local runners: { Player } = {}

    if #allPlayers == 1 then
        -- Solo testing mode: player is runner
        table.insert(runners, allPlayers[1])
    else
        -- Multiplayer mode: choose 1 controller (rotate if possible)
        local chosenController = allPlayers[1]
        for _, p in ipairs(allPlayers) do
            if p ~= lastControllerPlayer then
                chosenController = p
                break
            end
        end
        lastControllerPlayer = chosenController
        table.insert(controllers, chosenController)

        for _, p in ipairs(allPlayers) do
            if p ~= chosenController then
                table.insert(runners, p)
            end
        end
    end

    totalRunnersAtStart = #runners

    -- Assign roles and teleport players
    for _, controller in ipairs(controllers) do
        PlayerStateService.SetPlayerState(controller, Enums.PlayerState.TrapController)
        controller:LoadCharacter()
        task.wait(0.1)
        PlayerStateService.TeleportTo(controller, GameConfig.Coordinates.ControllerSpawn)
    end

    for _, runner in ipairs(runners) do
        PlayerStateService.SetPlayerState(runner, Enums.PlayerState.Runner)
        PlayerStateService.MarkRunnerAlive(runner)
        runner:LoadCharacter()
        task.wait(0.1)
        PlayerStateService.TeleportTo(runner, GameConfig.Coordinates.RunnerSpawn)
    end

    -- Close / open start barrier
    RoundService.SetStartBarrier(false) -- closed
    task.wait(2.0)
    RoundService.SetStartBarrier(true) -- open!

    NetworkService.FireAllClients(
        "Announcement",
        "ROUND STARTED!",
        "Runners: Navigate the course to escape! Controllers: Eliminate them!",
        Color3.fromRGB(0, 200, 255),
        "RoundStart"
    )

    RoundService.BroadcastRoundStatus(roundTimeRemaining)
end

function RoundService.EndRound(winnerTeam: string, reason: string)
    if currentRoundState ~= Enums.RoundState.InProgress then return end
    currentRoundState = Enums.RoundState.RoundEnded

    -- Award participation points to all connected players
    for _, player in ipairs(Players:GetPlayers()) do
        ScoringService.AddPoints(player, GameConfig.Points.Participation)
    end

    -- Award wins to winner team
    if winnerTeam == "Runners" then
        for _, runner in ipairs(PlayerStateService.GetActiveRunners()) do
            ScoringService.AddWin(runner)
        end
    elseif winnerTeam == "TrapControllers" then
        for _, controller in ipairs(PlayerStateService.GetTrapControllers()) do
            ScoringService.AddWin(controller)
        end
    end

    local title = winnerTeam == "Runners" and "RUNNERS ESCAPED!" or "TRAP CONTROLLERS WIN!"
    local subtitle = ""
    if reason == Enums.WinReason.RunnersEscaped then
        subtitle = "A runner reached the finish line!"
    elseif reason == Enums.WinReason.AllRunnersEliminated then
        subtitle = "All runners were eliminated!"
    elseif reason == Enums.WinReason.TimeExpired then
        subtitle = "Time expired! The controllers defended the course!"
    end

    NetworkService.FireAllClients(
        "Announcement",
        title,
        subtitle,
        winnerTeam == "Runners" and Color3.fromRGB(80, 255, 120) or Color3.fromRGB(255, 75, 75),
        "Victory"
    )

    NetworkService.FireAllClients("RoundStateChanged", currentRoundState, 0, {
        RunnersCount = #PlayerStateService.GetActiveRunners(),
        ControllersCount = #PlayerStateService.GetTrapControllers(),
        TotalRunnersStart = totalRunnersAtStart,
        WinnerTeam = winnerTeam,
        WinReason = reason,
    })
end

function RoundService.OnRunnerFinished(player: Player)
    if currentRoundState ~= Enums.RoundState.InProgress then return end
    if PlayerStateService.GetPlayerState(player) ~= Enums.PlayerState.Runner then return end

    if ScoringService.CanRewardFinish(player) then
        ScoringService.RecordFinish(player)
        ScoringService.AddPoints(player, GameConfig.Points.Finish)
        ScoringService.AddWin(player)

        NetworkService.FireAllClients(
            "Announcement",
            string.format("%s REACHED THE FINISH!", player.DisplayName),
            "Runners win this round!",
            Color3.fromRGB(255, 215, 0),
            "Finish"
        )

        RoundService.EndRound("Runners", Enums.WinReason.RunnersEscaped)
    end
end

function RoundService.OnRunnerEliminated(player: Player)
    if currentRoundState ~= Enums.RoundState.InProgress then return end

    local remainingRunners = PlayerStateService.GetActiveRunners()
    if #remainingRunners == 0 then
        RoundService.EndRound("TrapControllers", Enums.WinReason.AllRunnersEliminated)
    else
        RoundService.UpdateRoundHUD()
    end
end

function RoundService.OnPlayerLeft(player: Player)
    if currentRoundState == Enums.RoundState.InProgress then
        local activeRunners = PlayerStateService.GetActiveRunners()
        if #activeRunners == 0 then
            RoundService.EndRound("TrapControllers", Enums.WinReason.AllRunnersEliminated)
        else
            RoundService.UpdateRoundHUD()
        end
    end
end

function RoundService.UpdateRoundHUD()
    RoundService.BroadcastRoundStatus(roundTimeRemaining)
end

function RoundService.BroadcastRoundStatus(timeRemaining: number)
    local runners = PlayerStateService and PlayerStateService.GetActiveRunners() or {}
    local controllers = PlayerStateService and PlayerStateService.GetTrapControllers() or {}

    NetworkService.FireAllClients("RoundStateChanged", currentRoundState, timeRemaining, {
        RunnersCount = #runners,
        ControllersCount = #controllers,
        TotalRunnersStart = totalRunnersAtStart,
    })
end

function RoundService.SetStartBarrier(isOpen: boolean)
    local barrier = Workspace:FindFirstChild("Map") 
        and Workspace.Map:FindFirstChild("RunnerStart") 
        and Workspace.Map.RunnerStart:FindFirstChild("Barrier") :: BasePart?

    if barrier then
        barrier.CanCollide = not isOpen
        barrier.Transparency = isOpen and 0.9 or 0.3
        barrier.Color = isOpen and Color3.fromRGB(0, 255, 100) or Color3.fromRGB(255, 50, 50)
    end
end

function RoundService.CleanupAfterRound()
    TrapService.ResetAllTraps()
    RoundService.SetStartBarrier(false)

    -- Move all players back to lobby
    for _, player in ipairs(Players:GetPlayers()) do
        PlayerStateService.SetPlayerState(player, Enums.PlayerState.Lobby)
        player:LoadCharacter()
        task.wait(0.1)
        PlayerStateService.TeleportTo(player, GameConfig.Coordinates.LobbySpawn)
    end
end

return RoundService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="15">
        <Properties>
          <string name="Name">ScoringService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    ScoringService.luau
    Authoritative server-side scoring and leaderstats system.
]]

local Players = game:GetService("Players")

local ScoringService = {}

local finishedThisRound: { [Player]: boolean } = {}

function ScoringService.Init()
    Players.PlayerAdded:Connect(function(player)
        ScoringService.CreateLeaderstats(player)
    end)

    for _, player in ipairs(Players:GetPlayers()) do
        ScoringService.CreateLeaderstats(player)
    end
end

function ScoringService.CreateLeaderstats(player: Player)
    if player:FindFirstChild("leaderstats") then
        return
    end

    local leaderstats = Instance.new("Folder")
    leaderstats.Name = "leaderstats"

    local points = Instance.new("IntValue")
    points.Name = "Points"
    points.Value = 0
    points.Parent = leaderstats

    local wins = Instance.new("IntValue")
    wins.Name = "Wins"
    wins.Value = 0
    wins.Parent = leaderstats

    local kills = Instance.new("IntValue")
    kills.Name = "Kills"
    kills.Value = 0
    kills.Parent = leaderstats

    leaderstats.Parent = player
end

function ScoringService.AddPoints(player: Player, amount: number)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local points = leaderstats:FindFirstChild("Points") :: IntValue?
        if points then
            points.Value += amount
        end
    end
end

function ScoringService.AddWin(player: Player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local wins = leaderstats:FindFirstChild("Wins") :: IntValue?
        if wins then
            wins.Value += 1
        end
    end
end

function ScoringService.AddKill(player: Player)
    local leaderstats = player:FindFirstChild("leaderstats")
    if leaderstats then
        local kills = leaderstats:FindFirstChild("Kills") :: IntValue?
        if kills then
            kills.Value += 1
        end
    end
end

function ScoringService.CanRewardFinish(player: Player): boolean
    return not finishedThisRound[player]
end

function ScoringService.RecordFinish(player: Player)
    finishedThisRound[player] = true
end

function ScoringService.ResetRoundRewards()
    table.clear(finishedThisRound)
end

return ScoringService
]]></string>
        </Properties>
      </Item>
      <Item class="ModuleScript" referent="16">
        <Properties>
          <string name="Name">TrapService</string>
          <string name="Source"><![CDATA[--!strict
--[[
    TrapService.luau
    Authoritative server-side trap controller managing all 6 functional traps:
    1. CollapsingBridge
    2. SwingingHammer
    3. FallingCeiling
    4. MovingWall
    5. RotatingPlatform
    6. Pitfall

    Features:
    - Shared server-side cooldown enforcement across all trap controllers
    - Per-player input debounce to prevent rapid spamming
    - Real-time physics, tweens, and hazard zone damage
    - Clean state recovery and round reset
    - Remote notifications to sync client UI and audio
]]

local TweenService = game:GetService("TweenService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local Workspace = game:GetService("Workspace")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Enums = require(Shared:WaitForChild("Enums"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local TrapConfig = require(Shared:WaitForChild("TrapConfig"))

local TrapService = {}

type TrapState = {
    IsAvailable: boolean,
    IsActive: boolean,
    CooldownExpiry: number,
    ActiveExpiry: number,
    LastActivatedBy: Player?,
    ActiveThread: thread?,
}

local trapStates: { [string]: TrapState } = {}
local playerDebounce: { [Player]: number } = {}
local recentTrapController: Player? = nil
local recentTrapTime: number = 0

local NetworkService: any
local PlayerStateService: any
local RoundService: any

-- Default initial transforms and properties for clean resetting
local initialTransforms: { [string]: { [BasePart]: { CFrame: CFrame, CanCollide: boolean, Transparency: number, Color: Color3, Material: Enum.Material } } } = {}

function TrapService.Init(deps: { 
    NetworkService: any, 
    PlayerStateService: any, 
    RoundService: any 
})
    NetworkService = deps.NetworkService
    PlayerStateService = deps.PlayerStateService
    RoundService = deps.RoundService

    -- Initialize state for every trap definition
    for id, def in pairs(TrapConfig.Traps) do
        trapStates[id] = {
            IsAvailable = true,
            IsActive = false,
            CooldownExpiry = 0,
            ActiveExpiry = 0,
            LastActivatedBy = nil,
            ActiveThread = nil,
        }
        initialTransforms[id] = {}
    end

    -- Hook up remote client activation requests
    NetworkService.ConnectServerEvent("ActivateTrap", function(player: Player, trapId: string)
        TrapService.RequestTrapActivation(player, trapId)
    end)
end

function TrapService.RegisterTrapParts(trapId: string, model: Model)
    initialTransforms[trapId] = {}
    for _, desc in ipairs(model:GetDescendants()) do
        if desc:IsA("BasePart") then
            initialTransforms[trapId][desc] = {
                CFrame = desc.CFrame,
                CanCollide = desc.CanCollide,
                Transparency = desc.Transparency,
                Color = desc.Color,
                Material = desc.Material,
            }
        end
    end
end

function TrapService.RequestTrapActivation(player: Player, trapId: string): (boolean, string?)
    local def = TrapConfig.Traps[trapId]
    if not def then
        return false, "InvalidTrapId"
    end

    -- 1. Check player debounce
    local now = os.clock()
    local lastInput = playerDebounce[player] or 0
    if now - lastInput < GameConfig.PlayerInputDebounce then
        return false, "Debounced"
    end
    playerDebounce[player] = now

    -- 2. Validate round state
    if not RoundService or not RoundService.IsRoundInProgress() then
        return false, "RoundNotInProgress"
    end

    -- 3. Validate player role
    local role = PlayerStateService.GetPlayerState(player)
    if role ~= Enums.PlayerState.TrapController then
        -- Allow DevMode override for testing if enabled
        if not GameConfig.DevMode then
            return false, "UnauthorizedRole"
        end
    end

    -- 4. Validate player character is alive
    local character = player.Character
    if not character or not character:FindFirstChild("Humanoid") then
        return false, "CharacterNotAlive"
    end

    -- 5. Validate trap cooldown & availability (Mutual exclusion lock)
    local state = trapStates[trapId]
    if not state.IsAvailable or state.IsActive or now < state.CooldownExpiry then
        return false, "OnCooldown"
    end

    -- Acquire trap activation lock immediately
    state.IsAvailable = false
    state.IsActive = true
    state.CooldownExpiry = now + def.Cooldown
    state.ActiveExpiry = now + def.ActiveDuration
    state.LastActivatedBy = player
    recentTrapController = player
    recentTrapTime = now

    -- Broadcast state update to all clients for real-time UI/sound response
    NetworkService.FireAllClients(
        "TrapStateChanged",
        trapId,
        false, -- isAvailable
        true,  -- isActive
        def.Cooldown,
        def.ActiveDuration,
        player.DisplayName
    )

    NetworkService.FireAllClients(
        "Announcement",
        string.format("TRAP TRIGGERED: %s", string.upper(def.DisplayName)),
        string.format("Activated by %s", player.DisplayName),
        def.AccentColor,
        "TrapAlarm"
    )

    -- Launch authoritative physical trap execution in dedicated thread
    state.ActiveThread = task.spawn(function()
        TrapService.ExecuteTrap(trapId, def, player)
    end)

    return true, nil
end

function TrapService.ExecuteTrap(trapId: string, def: any, player: Player)
    local state = trapStates[trapId]
    local trapsFolder = Workspace:FindFirstChild("Map") and Workspace.Map:FindFirstChild("Traps")
    local trapModel = trapsFolder and trapsFolder:FindFirstChild(trapId)

    if trapModel then
        if trapId == "CollapsingBridge" then
            TrapService.RunCollapsingBridge(trapModel, def)
        elseif trapId == "SwingingHammer" then
            TrapService.RunSwingingHammer(trapModel, def, player)
        elseif trapId == "FallingCeiling" then
            TrapService.RunFallingCeiling(trapModel, def, player)
        elseif trapId == "MovingWall" then
            TrapService.RunMovingWall(trapModel, def, player)
        elseif trapId == "RotatingPlatform" then
            TrapService.RunRotatingPlatform(trapModel, def)
        elseif trapId == "Pitfall" then
            TrapService.RunPitfall(trapModel, def)
        end
    else
        -- If physical model is not yet in workspace, wait out the duration
        task.wait(def.ActiveDuration)
    end

    -- Trap physical active duration has finished
    state.IsActive = false

    local now = os.clock()
    local remainingCooldown = math.max(0, state.CooldownExpiry - now)

    -- Broadcast active ended, entering cooldown
    NetworkService.FireAllClients(
        "TrapStateChanged",
        trapId,
        false, -- isAvailable
        false, -- isActive
        remainingCooldown,
        0,
        nil
    )

    -- Wait out remaining cooldown
    if remainingCooldown > 0 then
        task.wait(remainingCooldown)
    end

    -- Cooldown complete! Reset to available
    state.IsAvailable = true
    state.ActiveThread = nil

    NetworkService.FireAllClients(
        "TrapStateChanged",
        trapId,
        true,  -- isAvailable
        false, -- isActive
        0,
        0,
        nil
    )
end

-- ==================== TRAP 1: COLLAPSING BRIDGE ====================
function TrapService.RunCollapsingBridge(model: Model, def: any)
    local warningPillars = model:FindFirstChild("WarningPillars")
    local planksFolder = model:FindFirstChild("Planks")

    -- Warning flash
    if warningPillars then
        for _, part in ipairs(warningPillars:GetChildren()) do
            if part:IsA("BasePart") then
                part.Color = Color3.fromRGB(255, 30, 30)
                part.Material = Enum.Material.Neon
            end
        end
    end
    task.wait(def.WarningDuration)

    -- Drop bridge planks
    if planksFolder then
        for _, plank in ipairs(planksFolder:GetChildren()) do
            if plank:IsA("BasePart") then
                plank.CanCollide = false
                plank.Transparency = 0.85
                plank.Color = Color3.fromRGB(255, 50, 50)
            end
        end
    end

    task.wait(def.ActiveDuration)

    -- Restore bridge planks
    if planksFolder then
        for _, plank in ipairs(planksFolder:GetChildren()) do
            if plank:IsA("BasePart") then
                plank.CanCollide = true
                plank.Transparency = 0
                plank.Color = Color3.fromRGB(80, 85, 95)
                plank.Material = Enum.Material.DiamondPlate
            end
        end
    end
    if warningPillars then
        for _, part in ipairs(warningPillars:GetChildren()) do
            if part:IsA("BasePart") then
                part.Color = Color3.fromRGB(60, 60, 60)
                part.Material = Enum.Material.SmoothPlastic
            end
        end
    end
end

-- ==================== TRAP 2: SWINGING HAMMER ====================
function TrapService.RunSwingingHammer(model: Model, def: any, player: Player)
    local arch = model:FindFirstChild("Arch")
    local hammer = model:FindFirstChild("Hammer") :: Model?
    local head = hammer and hammer:FindFirstChild("Head") :: BasePart?
    local pivot = model:FindFirstChild("Pivot") :: BasePart?

    -- Warning indication
    if arch then
        for _, p in ipairs(arch:GetChildren()) do
            if p:IsA("BasePart") and p.Name:find("Beacon") then
                p.Color = Color3.fromRGB(255, 170, 0)
                p.Material = Enum.Material.Neon
            end
        end
    end
    task.wait(def.WarningDuration)

    -- Connect lethal touch during swing
    local touchConn: RBXScriptConnection? = nil
    if head then
        touchConn = head.Touched:Connect(function(hit)
            local char = hit.Parent
            local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
            if hum and hum.Health > 0 then
                local root = char:FindFirstChild("HumanoidRootPart") :: BasePart?
                if root then
                    -- Fling runner off platform with lateral knockback
                    root.AssemblyLinearVelocity = Vector3.new(0, 40, -60)
                end
                hum:TakeDamage(100)
            end
        end)
    end

    -- Swing hammer back and forth across walkway
    local startTime = os.clock()
    local duration = def.ActiveDuration
    local swingAngleMax = math.rad(65)

    local initialCFrame = hammer and hammer:GetPivot() or CFrame.new()

    while os.clock() - startTime < duration do
        local elapsed = os.clock() - startTime
        local progress = elapsed / duration
        -- Sinusoidal swing: 2 full swings
        local currentAngle = math.sin(progress * math.pi * 4) * swingAngleMax

        if hammer and pivot then
            hammer:PivotTo(pivot.CFrame * CFrame.Angles(0, 0, currentAngle))
        end
        task.wait(0.03)
    end

    if touchConn then
        touchConn:Disconnect()
    end

    -- Return hammer to rest position
    if hammer and initialCFrame then
        hammer:PivotTo(initialCFrame)
    end
end

-- ==================== TRAP 3: FALLING CEILING ====================
function TrapService.RunFallingCeiling(model: Model, def: any, player: Player)
    local crusher = model:FindFirstChild("Crusher") :: BasePart?
    local warningLights = model:FindFirstChild("WarningLights")

    if warningLights then
        for _, light in ipairs(warningLights:GetChildren()) do
            if light:IsA("BasePart") then
                light.Color = Color3.fromRGB(255, 20, 20)
                light.Material = Enum.Material.Neon
            end
        end
    end
    task.wait(def.WarningDuration)

    if crusher then
        local originalCFrame = crusher.CFrame
        local downCFrame = originalCFrame - Vector3.new(0, 16, 0)

        -- Lethal touch connection while crushing
        local touchConn = crusher.Touched:Connect(function(hit)
            local char = hit.Parent
            local hum = char and char:FindFirstChild("Humanoid") :: Humanoid?
            if hum and hum.Health > 0 then
                hum:TakeDamage(100)
            end
        end)

        -- Slam down rapidly in 0.25s
        local slamTween = TweenService:Create(crusher, TweenInfo.new(0.25, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            CFrame = downCFrame
        })
        slamTween:Play()
        slamTween.Completed:Wait()

        -- Hold crushed position
        task.wait(1.5)

        if touchConn then
            touchConn:Disconnect()
        end

        -- Retract back up to ceiling
        local retractTween = TweenService:Create(crusher, TweenInfo.new(1.25, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = originalCFrame
        })
        retractTween:Play()
        retractTween.Completed:Wait()
    else
        task.wait(def.ActiveDuration)
    end

    if warningLights then
        for _, light in ipairs(warningLights:GetChildren()) do
            if light:IsA("BasePart") then
                light.Color = Color3.fromRGB(50, 50, 50)
                light.Material = Enum.Material.SmoothPlastic
            end
        end
    end
end

-- ==================== TRAP 4: MOVING WALL ====================
function TrapService.RunMovingWall(model: Model, def: any, player: Player)
    local wall = model:FindFirstChild("Pusher") :: BasePart?
    local warningSign = model:FindFirstChild("WarningSign") :: BasePart?

    if warningSign then
        warningSign.Color = Color3.fromRGB(0, 200, 255)
        warningSign.Material = Enum.Material.Neon
    end
    task.wait(def.WarningDuration)

    if wall then
        local originalCFrame = wall.CFrame
        local extendedCFrame = originalCFrame + Vector3.new(24, 0, 0)

        -- Wall fling touch
        local touchConn = wall.Touched:Connect(function(hit)
            local char = hit.Parent
            local root = char and char:FindFirstChild("HumanoidRootPart") :: BasePart?
            if root then
                root.AssemblyLinearVelocity = Vector3.new(80, 25, 0)
            end
        end)

        -- Push across catwalk in 0.4s
        local pushTween = TweenService:Create(wall, TweenInfo.new(0.4, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = extendedCFrame
        })
        pushTween:Play()
        pushTween.Completed:Wait()

        -- Hold extended
        task.wait(1.8)

        if touchConn then
            touchConn:Disconnect()
        end

        -- Retract back into wall
        local retractTween = TweenService:Create(wall, TweenInfo.new(1.6, Enum.EasingStyle.Quad, Enum.EasingDirection.InOut), {
            CFrame = originalCFrame
        })
        retractTween:Play()
        retractTween.Completed:Wait()
    else
        task.wait(def.ActiveDuration)
    end

    if warningSign then
        warningSign.Color = Color3.fromRGB(50, 50, 50)
        warningSign.Material = Enum.Material.SmoothPlastic
    end
end

-- ==================== TRAP 5: ROTATING PLATFORM ====================
function TrapService.RunRotatingPlatform(model: Model, def: any)
    local platform = model:FindFirstChild("SpinPlatform") :: BasePart?
    local beacons = model:FindFirstChild("Beacons")

    if beacons then
        for _, b in ipairs(beacons:GetChildren()) do
            if b:IsA("BasePart") then
                b.Color = Color3.fromRGB(200, 50, 255)
                b.Material = Enum.Material.Neon
            end
        end
    end
    task.wait(def.WarningDuration)

    if platform then
        local originalCFrame = platform.CFrame
        local startTime = os.clock()
        local duration = def.ActiveDuration

        while os.clock() - startTime < duration do
            local elapsed = os.clock() - startTime
            -- Spin around Y-axis rapidly, and tilt along Z-axis
            local spinAngle = elapsed * math.pi * 3
            local tiltAngle = math.sin(elapsed * math.pi * 2) * math.rad(45)

            platform.CFrame = originalCFrame * CFrame.Angles(tiltAngle, spinAngle, 0)
            task.wait(0.03)
        end

        -- Restore flat orientation
        local restoreTween = TweenService:Create(platform, TweenInfo.new(0.5, Enum.EasingStyle.Quad, Enum.EasingDirection.Out), {
            CFrame = originalCFrame
        })
        restoreTween:Play()
        restoreTween.Completed:Wait()
    else
        task.wait(def.ActiveDuration)
    end

    if beacons then
        for _, b in ipairs(beacons:GetChildren()) do
            if b:IsA("BasePart") then
                b.Color = Color3.fromRGB(50, 50, 50)
                b.Material = Enum.Material.SmoothPlastic
            end
        end
    end
end

-- ==================== TRAP 6: PITFALL ====================
function TrapService.RunPitfall(model: Model, def: any)
    local doorLeft = model:FindFirstChild("HatchLeft") :: BasePart?
    local doorRight = model:FindFirstChild("HatchRight") :: BasePart?
    local warningFrame = model:FindFirstChild("WarningFrame")

    if warningFrame then
        for _, part in ipairs(warningFrame:GetChildren()) do
            if part:IsA("BasePart") then
                part.Color = Color3.fromRGB(255, 30, 130)
                part.Material = Enum.Material.Neon
            end
        end
    end
    task.wait(def.WarningDuration)

    -- Drop trapdoors open
    if doorLeft and doorRight then
        doorLeft.CanCollide = false
        doorLeft.Transparency = 0.85
        doorLeft.Color = Color3.fromRGB(255, 50, 50)

        doorRight.CanCollide = false
        doorRight.Transparency = 0.85
        doorRight.Color = Color3.fromRGB(255, 50, 50)
    end

    task.wait(def.ActiveDuration)

    -- Close trapdoors
    if doorLeft and doorRight then
        doorLeft.CanCollide = true
        doorLeft.Transparency = 0
        doorLeft.Color = Color3.fromRGB(70, 75, 85)
        doorLeft.Material = Enum.Material.DiamondPlate

        doorRight.CanCollide = true
        doorRight.Transparency = 0
        doorRight.Color = Color3.fromRGB(70, 75, 85)
        doorRight.Material = Enum.Material.DiamondPlate
    end

    if warningFrame then
        for _, part in ipairs(warningFrame:GetChildren()) do
            if part:IsA("BasePart") then
                part.Color = Color3.fromRGB(50, 50, 50)
                part.Material = Enum.Material.SmoothPlastic
            end
        end
    end
end

function TrapService.ResetAllTraps()
    -- Cancel active trap threads
    for _, state in pairs(trapStates) do
        if state.ActiveThread then
            task.cancel(state.ActiveThread)
            state.ActiveThread = nil
        end
        state.IsAvailable = true
        state.IsActive = false
        state.CooldownExpiry = 0
        state.ActiveExpiry = 0
        state.LastActivatedBy = nil
    end

    -- Restore saved initial transforms & appearances
    for trapId, partsMap in pairs(initialTransforms) do
        for part, props in pairs(partsMap) do
            if part and part.Parent then
                part.CFrame = props.CFrame
                part.CanCollide = props.CanCollide
                part.Transparency = props.Transparency
                part.Color = props.Color
                part.Material = props.Material
                part.AssemblyLinearVelocity = Vector3.zero
                part.AssemblyAngularVelocity = Vector3.zero
            end
        end
    end

    -- Broadcast reset to all clients
    for id, _ in pairs(TrapConfig.Traps) do
        NetworkService.FireAllClients("TrapStateChanged", id, true, false, 0, 0, nil)
    end
end

function TrapService.GetRecentTrapController(): Player?
    if os.clock() - recentTrapTime < 5.0 then
        return recentTrapController
    end
    return nil
end

return TrapService
]]></string>
        </Properties>
      </Item>
    </Item>
