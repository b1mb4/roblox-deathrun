      <Item class="LocalScript" referent="20">
        <Properties>
          <string name="Name">ClientMain</string>
          <string name="Source"><![CDATA[--!strict
--[[
    ClientMain.client.luau
    Client bootstrap for Roblox Deathrun.
    Wires all client controllers and remote network events.
]]

local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local StarterPlayer = game:GetService("StarterPlayer")

local localPlayer = Players.LocalPlayer
local controllersFolder = script.Parent:WaitForChild("Controllers")

local SoundController = require(controllersFolder:WaitForChild("SoundController"))
local NotificationController = require(controllersFolder:WaitForChild("NotificationController"))
local TrapClientController = require(controllersFolder:WaitForChild("TrapClientController"))
local UIController = require(controllersFolder:WaitForChild("UIController"))

print("[RobloxDeathrun Client] Initializing client subsystems...")

-- Initialize Controllers
SoundController.Init()
TrapClientController.Init({ SoundController = SoundController })
UIController.Init({ TrapClientController = TrapClientController })

-- Wire NotificationController with the main ScreenGui
local playerGui = localPlayer:WaitForChild("PlayerGui")
local mainGui = playerGui:WaitForChild("DeathrunMainGui") :: ScreenGui
NotificationController.Init(mainGui)

-- Listen to server Remotes
local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
if remotes then
    local playerStateChanged = remotes:WaitForChild("PlayerStateChanged") :: RemoteEvent
    local roundStateChanged = remotes:WaitForChild("RoundStateChanged") :: RemoteEvent
    local announcement = remotes:WaitForChild("Announcement") :: RemoteEvent
    local checkpointReached = remotes:WaitForChild("CheckpointReached") :: RemoteEvent

    playerStateChanged.OnClientEvent:Connect(function(newRole: string)
        UIController.UpdateRole(newRole)
    end)

    roundStateChanged.OnClientEvent:Connect(function(state: string, timeRemaining: number, extra: any)
        UIController.UpdateRoundStatus(state, timeRemaining, extra)
    end)

    announcement.OnClientEvent:Connect(function(title: string, subtitle: string, color: Color3?, sound: string?)
        NotificationController.ShowBanner(title, subtitle, color)
        if sound and SoundController then
            SoundController.PlaySound(sound)
        end
    end)

    checkpointReached.OnClientEvent:Connect(function(index: number)
        UIController.UpdateCheckpoint(index)
    end)
end

print("[RobloxDeathrun Client] Client ready! Ready for Deathrun action.")
]]></string>
        </Properties>
      </Item>
      <Item class="Folder" referent="21">
        <Properties>
          <string name="Name">Controllers</string>
        </Properties>
        <Item class="ModuleScript" referent="22">
          <Properties>
            <string name="Name">NotificationController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    NotificationController.luau
    Displays animated HUD toast announcements for round events, eliminations, and checkpoints.
]]

local TweenService = game:GetService("TweenService")
local Players = game:GetService("Players")

local NotificationController = {}
local screenGui: ScreenGui
local bannerContainer: Frame
local titleLabel: TextLabel
local subtitleLabel: TextLabel
local currentTween: Tween? = nil

function NotificationController.Init(gui: ScreenGui)
    screenGui = gui

    bannerContainer = Instance.new("Frame")
    bannerContainer.Name = "AnnouncementBanner"
    bannerContainer.Size = UDim2.new(0, 480, 0, 70)
    bannerContainer.Position = UDim2.new(0.5, -240, -0.2, 0)
    bannerContainer.BackgroundColor3 = Color3.fromRGB(15, 17, 24)
    bannerContainer.BackgroundTransparency = 0.15
    bannerContainer.BorderSizePixel = 0
    bannerContainer.Visible = false
    bannerContainer.ZIndex = 100
    bannerContainer.Parent = screenGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = bannerContainer

    local stroke = Instance.new("UIStroke")
    stroke.Name = "BorderStroke"
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(0, 170, 255)
    stroke.Parent = bannerContainer

    titleLabel = Instance.new("TextLabel")
    titleLabel.Name = "Title"
    titleLabel.Size = UDim2.new(1, -20, 0, 32)
    titleLabel.Position = UDim2.new(0, 10, 0, 6)
    titleLabel.BackgroundTransparency = 1
    titleLabel.Font = Enum.Font.GothamBold
    titleLabel.TextSize = 20
    titleLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    titleLabel.Text = "ROUND STARTED"
    titleLabel.Parent = bannerContainer

    subtitleLabel = Instance.new("TextLabel")
    subtitleLabel.Name = "Subtitle"
    subtitleLabel.Size = UDim2.new(1, -20, 0, 24)
    subtitleLabel.Position = UDim2.new(0, 10, 0, 38)
    subtitleLabel.BackgroundTransparency = 1
    subtitleLabel.Font = Enum.Font.GothamMedium
    subtitleLabel.TextSize = 14
    subtitleLabel.TextColor3 = Color3.fromRGB(200, 210, 230)
    subtitleLabel.Text = "Survive to reach the finish!"
    subtitleLabel.Parent = bannerContainer
end

function NotificationController.ShowBanner(title: string, subtitle: string, accentColor: Color3?)
    if not bannerContainer then return end

    titleLabel.Text = string.upper(title)
    subtitleLabel.Text = subtitle

    local color = accentColor or Color3.fromRGB(0, 170, 255)
    titleLabel.TextColor3 = color
    local stroke = bannerContainer:FindFirstChild("BorderStroke") :: UIStroke?
    if stroke then
        stroke.Color = color
    end

    bannerContainer.Visible = true

    -- Animate slide in from top
    bannerContainer.Position = UDim2.new(0.5, -240, -0.15, 0)
    local slideIn = TweenService:Create(bannerContainer, TweenInfo.new(0.35, Enum.EasingStyle.Back, Enum.EasingDirection.Out), {
        Position = UDim2.new(0.5, -240, 0.08, 0)
    })
    slideIn:Play()

    task.spawn(function()
        task.wait(2.8)
        local slideOut = TweenService:Create(bannerContainer, TweenInfo.new(0.3, Enum.EasingStyle.Quad, Enum.EasingDirection.In), {
            Position = UDim2.new(0.5, -240, -0.2, 0)
        })
        slideOut:Play()
        slideOut.Completed:Wait()
        bannerContainer.Visible = false
    end)
end

return NotificationController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="23">
          <Properties>
            <string name="Name">SoundController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    SoundController.luau
    Client sound effects player for UI clicks, alarms, and notifications.
]]

local SoundService = game:GetService("SoundService")

local SoundController = {}
local soundsFolder: Folder

-- Standard Roblox verified audio assets or procedural pitch sounds
local SOUND_CONFIGS = {
    Click = { SoundId = "rbxasset://sounds/uiclick.wav", Volume = 0.5, Pitch = 1.0 },
    Error = { SoundId = "rbxasset://sounds/electronicpingshort.wav", Volume = 0.6, Pitch = 0.5 },
    TrapAlarm = { SoundId = "rbxasset://sounds/action_falling.mp3", Volume = 0.7, Pitch = 1.2 },
    Victory = { SoundId = "rbxasset://sounds/victory.wav", Volume = 0.8, Pitch = 1.0 },
    Death = { SoundId = "rbxasset://sounds/ouch.ogg", Volume = 0.6, Pitch = 0.9 },
    Checkpoint = { SoundId = "rbxasset://sounds/bell.wav", Volume = 0.6, Pitch = 1.2 },
    RoundStart = { SoundId = "rbxasset://sounds/button.wav", Volume = 0.8, Pitch = 1.5 },
}

local createdSounds: { [string]: Sound } = {}

function SoundController.Init()
    soundsFolder = Instance.new("Folder")
    soundsFolder.Name = "DeathrunSounds"
    soundsFolder.Parent = SoundService

    for name, config in pairs(SOUND_CONFIGS) do
        local sound = Instance.new("Sound")
        sound.Name = name
        sound.SoundId = config.SoundId
        sound.Volume = config.Volume
        sound.PlaybackSpeed = config.Pitch
        sound.Parent = soundsFolder
        createdSounds[name] = sound
    end
end

function SoundController.PlaySound(name: string)
    local sound = createdSounds[name]
    if sound then
        sound:Play()
    end
end

return SoundController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="24">
          <Properties>
            <string name="Name">TrapClientController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    TrapClientController.luau
    Handles client input for trap triggers (keyboard 1-6 & UI buttons)
    and synchronizes shared trap cooldowns and active states.
]]

local UserInputService = game:GetService("UserInputService")
local ReplicatedStorage = game:GetService("ReplicatedStorage")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local TrapConfig = require(Shared:WaitForChild("TrapConfig"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))

local TrapClientController = {}

type ClientTrapState = {
    IsAvailable: boolean,
    IsActive: boolean,
    CooldownRemaining: number,
    ActiveRemaining: number,
    CooldownTotal: number,
    LastUpdated: number,
}

local clientTrapStates: { [string]: ClientTrapState } = {}
local lastClickTime: number = 0
local SoundController: any
local onStateChangedCallback: ((trapId: string, state: ClientTrapState) -> ())? = nil

local activateRemote: RemoteEvent? = nil
local stateChangedRemote: RemoteEvent? = nil

function TrapClientController.Init(deps: { SoundController: any })
    SoundController = deps.SoundController

    -- Initialize local state cache for each trap
    for id, def in pairs(TrapConfig.Traps) do
        clientTrapStates[id] = {
            IsAvailable = true,
            IsActive = false,
            CooldownRemaining = 0,
            ActiveRemaining = 0,
            CooldownTotal = def.Cooldown,
            LastUpdated = os.clock(),
        }
    end

    local remotes = ReplicatedStorage:WaitForChild("Remotes", 10)
    if remotes then
        activateRemote = remotes:WaitForChild("ActivateTrap") :: RemoteEvent
        stateChangedRemote = remotes:WaitForChild("TrapStateChanged") :: RemoteEvent

        stateChangedRemote.OnClientEvent:Connect(function(
            trapId: string,
            isAvailable: boolean,
            isActive: boolean,
            cooldownRemaining: number,
            activeRemaining: number,
            _triggeredBy: string?
        )
            TrapClientController.UpdateTrapState(trapId, isAvailable, isActive, cooldownRemaining, activeRemaining)
        end)
    end

    -- Hook up keyboard number shortcuts [1] to [6]
    UserInputService.InputBegan:Connect(function(input, gameProcessed)
        if gameProcessed then return end
        if input.UserInputType == Enum.UserInputType.Keyboard then
            local keyName = input.KeyCode.Name
            local keyMap: { [string]: string } = {
                One = "CollapsingBridge",
                Two = "SwingingHammer",
                Three = "FallingCeiling",
                Four = "MovingWall",
                Five = "RotatingPlatform",
                Six = "Pitfall",
            }
            local trapId = keyMap[keyName]
            if trapId then
                TrapClientController.RequestActivation(trapId)
            end
        end
    end)
end

function TrapClientController.SetOnStateChanged(callback: (trapId: string, state: ClientTrapState) -> ())
    onStateChangedCallback = callback
end

function TrapClientController.RequestActivation(trapId: string)
    local now = os.clock()
    if now - lastClickTime < GameConfig.PlayerInputDebounce then
        return
    end
    lastClickTime = now

    local state = clientTrapStates[trapId]
    if not state then return end

    if not state.IsAvailable or state.IsActive or state.CooldownRemaining > 0 then
        if SoundController then
            SoundController.PlaySound("Error")
        end
        return
    end

    if SoundController then
        SoundController.PlaySound("Click")
    end

    if activateRemote then
        activateRemote:FireServer(trapId)
    end
end

function TrapClientController.UpdateTrapState(
    trapId: string,
    isAvailable: boolean,
    isActive: boolean,
    cooldownRemaining: number,
    activeRemaining: number
)
    local state = clientTrapStates[trapId]
    if not state then return end

    state.IsAvailable = isAvailable
    state.IsActive = isActive
    state.CooldownRemaining = cooldownRemaining
    state.ActiveRemaining = activeRemaining
    state.LastUpdated = os.clock()

    if onStateChangedCallback then
        onStateChangedCallback(trapId, state)
    end
end

function TrapClientController.GetTrapState(trapId: string): ClientTrapState?
    return clientTrapStates[trapId]
end

return TrapClientController
]]></string>
          </Properties>
        </Item>
        <Item class="ModuleScript" referent="25">
          <Properties>
            <string name="Name">UIController</string>
            <string name="Source"><![CDATA[--!strict
--[[
    UIController.luau
    Authoritative client-side interface manager:
    - TrapControlGui: Responsive trap cards with real-time countdowns, hotkeys, and cooldown fills
    - RoundStatusGui: Top bar with status pill, clock, alive runners & controllers count
    - RunnerHUD: Checkpoint progress & survival objective
    - ResultsGui: End of round victory banner
    - DevPanel: Toggle role and solo test utilities
]]

local RunService = game:GetService("RunService")
local Players = game:GetService("Players")
local ReplicatedStorage = game:GetService("ReplicatedStorage")
local TweenService = game:GetService("TweenService")

local Shared = ReplicatedStorage:WaitForChild("Shared")
local Enums = require(Shared:WaitForChild("Enums"))
local GameConfig = require(Shared:WaitForChild("GameConfig"))
local TrapConfig = require(Shared:WaitForChild("TrapConfig"))

local UIController = {}

local player = Players.LocalPlayer
local playerGui = player:WaitForChild("PlayerGui")

local mainGui: ScreenGui
local roundStatusFrame: Frame
local trapControlFrame: Frame
local runnerHudFrame: Frame
local resultsFrame: Frame
local devPanelFrame: Frame

local timeLabel: TextLabel
local statusLabel: TextLabel
local runnersCountLabel: TextLabel
local controllersCountLabel: TextLabel

local checkpointLabel: TextLabel
local resultsTitleLabel: TextLabel
local resultsSubtitleLabel: TextLabel

type TrapCardElements = {
    Card: TextButton,
    Title: TextLabel,
    Description: TextLabel,
    StatusBadge: TextLabel,
    CooldownText: TextLabel,
    ProgressBar: Frame,
    ProgressFill: Frame,
    Stroke: UIStroke,
    Icon: TextLabel,
}

local trapCards: { [string]: TrapCardElements } = {}
local TrapClientController: any
local currentRole: string = Enums.PlayerState.Lobby

function UIController.Init(deps: { TrapClientController: any })
    TrapClientController = deps.TrapClientController

    -- Create root ScreenGui
    mainGui = Instance.new("ScreenGui")
    mainGui.Name = "DeathrunMainGui"
    mainGui.ResetOnSpawn = false
    mainGui.ZIndexBehavior = Enum.ZIndexBehavior.Sibling
    mainGui.Parent = playerGui

    -- Build all UI components
    UIController.BuildRoundStatusHUD()
    UIController.BuildTrapControlPanel()
    UIController.BuildRunnerHUD()
    UIController.BuildResultsModal()
    UIController.BuildDevPanel()

    -- Hook up real-time frame tick for smooth cooldown countdowns
    RunService.RenderStepped:Connect(function()
        UIController.UpdateCooldownVisuals()
    end)
end

function UIController.BuildRoundStatusHUD()
    roundStatusFrame = Instance.new("Frame")
    roundStatusFrame.Name = "RoundStatusHUD"
    roundStatusFrame.Size = UDim2.new(0, 480, 0, 52)
    roundStatusFrame.Position = UDim2.new(0.5, -240, 0, 14)
    roundStatusFrame.BackgroundColor3 = Color3.fromRGB(16, 18, 24)
    roundStatusFrame.BackgroundTransparency = 0.2
    roundStatusFrame.BorderSizePixel = 0
    roundStatusFrame.Parent = mainGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 10)
    corner.Parent = roundStatusFrame

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 1.5
    stroke.Color = Color3.fromRGB(40, 45, 60)
    stroke.Parent = roundStatusFrame

    -- Status Pill (Left)
    statusLabel = Instance.new("TextLabel")
    statusLabel.Name = "StatusLabel"
    statusLabel.Size = UDim2.new(0, 170, 0, 32)
    statusLabel.Position = UDim2.new(0, 10, 0, 10)
    statusLabel.BackgroundColor3 = Color3.fromRGB(24, 28, 38)
    statusLabel.BackgroundTransparency = 0.3
    statusLabel.Font = Enum.Font.GothamBold
    statusLabel.TextSize = 13
    statusLabel.TextColor3 = Color3.fromRGB(0, 200, 255)
    statusLabel.Text = "WAITING FOR PLAYERS"
    statusLabel.Parent = roundStatusFrame
    local statusCorner = Instance.new("UICorner")
    statusCorner.CornerRadius = UDim.new(0, 6)
    statusCorner.Parent = statusLabel

    -- Clock Timer (Center)
    timeLabel = Instance.new("TextLabel")
    timeLabel.Name = "TimeLabel"
    timeLabel.Size = UDim2.new(0, 90, 0, 36)
    timeLabel.Position = UDim2.new(0.5, -45, 0, 8)
    timeLabel.BackgroundTransparency = 1
    timeLabel.Font = Enum.Font.GothamBlack
    timeLabel.TextSize = 22
    timeLabel.TextColor3 = Color3.fromRGB(255, 255, 255)
    timeLabel.Text = "00:00"
    timeLabel.Parent = roundStatusFrame

    -- Team Counts (Right)
    local countsContainer = Instance.new("Frame")
    countsContainer.Name = "CountsContainer"
    countsContainer.Size = UDim2.new(0, 180, 0, 34)
    countsContainer.Position = UDim2.new(1, -190, 0, 9)
    countsContainer.BackgroundTransparency = 1
    countsContainer.Parent = roundStatusFrame

    runnersCountLabel = Instance.new("TextLabel")
    runnersCountLabel.Name = "RunnersCount"
    runnersCountLabel.Size = UDim2.new(0, 85, 1, 0)
    runnersCountLabel.Position = UDim2.new(0, 0, 0, 0)
    runnersCountLabel.BackgroundColor3 = Color3.fromRGB(20, 40, 30)
    runnersCountLabel.BackgroundTransparency = 0.3
    runnersCountLabel.Font = Enum.Font.GothamBold
    runnersCountLabel.TextSize = 12
    runnersCountLabel.TextColor3 = Color3.fromRGB(80, 255, 140)
    runnersCountLabel.Text = "🟢 0 Runners"
    runnersCountLabel.Parent = countsContainer
    local rCorner = Instance.new("UICorner")
    rCorner.CornerRadius = UDim.new(0, 6)
    rCorner.Parent = runnersCountLabel

    controllersCountLabel = Instance.new("TextLabel")
    controllersCountLabel.Name = "ControllersCount"
    controllersCountLabel.Size = UDim2.new(0, 85, 1, 0)
    controllersCountLabel.Position = UDim2.new(0, 92, 0, 0)
    controllersCountLabel.BackgroundColor3 = Color3.fromRGB(45, 20, 25)
    controllersCountLabel.BackgroundTransparency = 0.3
    controllersCountLabel.Font = Enum.Font.GothamBold
    controllersCountLabel.TextSize = 12
    controllersCountLabel.TextColor3 = Color3.fromRGB(255, 90, 90)
    controllersCountLabel.Text = "🔴 0 Traps"
    controllersCountLabel.Parent = countsContainer
    local cCorner = Instance.new("UICorner")
    cCorner.CornerRadius = UDim.new(0, 6)
    cCorner.Parent = controllersCountLabel
end

function UIController.BuildTrapControlPanel()
    trapControlFrame = Instance.new("Frame")
    trapControlFrame.Name = "TrapControlPanel"
    trapControlFrame.Size = UDim2.new(0, 960, 0, 160)
    trapControlFrame.Position = UDim2.new(0.5, -480, 1, -175)
    trapControlFrame.BackgroundColor3 = Color3.fromRGB(14, 16, 22)
    trapControlFrame.BackgroundTransparency = 0.15
    trapControlFrame.BorderSizePixel = 0
    trapControlFrame.Visible = false
    trapControlFrame.Parent = mainGui

    local corner = Instance.new("UICorner")
    corner.CornerRadius = UDim.new(0, 12)
    corner.Parent = trapControlFrame

    local stroke = Instance.new("UIStroke")
    stroke.Thickness = 2
    stroke.Color = Color3.fromRGB(255, 75, 75)
    stroke.Parent = trapControlFrame

    -- Header Title
    local header = Instance.new("TextLabel")
    header.Name = "Header"
    header.Size = UDim2.new(1, -20, 0, 24)
    header.Position = UDim2.new(0, 10, 0, 6)
    header.BackgroundTransparency = 1
    header.Font = Enum.Font.GothamBlack
    header.TextSize = 13
    header.TextColor3 = Color3.fromRGB(255, 100, 100)
    header.TextXAlignment = Enum.TextXAlignment.Left
    header.Text = "⚠️ TRAP CONTROL SYSTEM — SELECT TRAP OR PRESS HOTKEYS [1-6]"
    header.Parent = trapControlFrame

    -- Grid of 6 trap cards
    local grid = Instance.new("Frame")
    grid.Name = "TrapGrid"
    grid.Size = UDim2.new(1, -20, 0, 120)
    grid.Position = UDim2.new(0, 10, 0, 32)
    grid.BackgroundTransparency = 1
    grid.Parent = trapControlFrame

    local listLayout = Instance.new("UIListLayout")
    listLayout.FillDirection = Enum.FillDirection.Horizontal
    listLayout.HorizontalAlignment = Enum.HorizontalAlignment.Center
    listLayout.Padding = UDim.new(0, 8)
    listLayout.Parent = grid

    for _, trapId in ipairs(TrapConfig.Order) do
        local def = TrapConfig.Traps[trapId]
        local card = Instance.new("TextButton")
        card.Name = "Card_" .. trapId
        card.Size = UDim2.new(0, 148, 0, 118)
        card.BackgroundColor3 = Color3.fromRGB(22, 25, 34)
        card.AutoButtonColor = false
        card.Text = ""
        card.Parent = grid

        local cardCorner = Instance.new("UICorner")
        cardCorner.CornerRadius = UDim.new(0, 8)
        cardCorner.Parent = card

        local cardStroke = Instance.new("UIStroke")
        cardStroke.Thickness = 1.5
        cardStroke.Color = Color3.fromRGB(46, 204, 113)
        cardStroke.Parent = card

        -- Icon + Keybind badge
        local icon = Instance.new("TextLabel")
        icon.Name = "Icon"
        icon.Size = UDim2.new(0, 28, 0, 24)
        icon.Position = UDim2.new(0, 8, 0, 6)
        icon.BackgroundTransparency = 1
        icon.TextSize = 18
        icon.Text = def.Icon
        icon.Parent = card

        local keyBadge = Instance.new("TextLabel")
        keyBadge.Name = "KeyBadge"
        keyBadge.Size = UDim2.new(0, 26, 0, 18)
        keyBadge.Position = UDim2.new(1, -34, 0, 8)
        keyBadge.BackgroundColor3 = Color3.fromRGB(35, 40, 55)
        keyBadge.Font = Enum.Font.GothamBold
        keyBadge.TextSize = 11
        keyBadge.TextColor3 = Color3.fromRGB(0, 200, 255)
        keyBadge.Text = "[" .. def.Keybind .. "]"
        keyBadge.Parent = card
        local kCorner = Instance.new("UICorner")
        kCorner.CornerRadius = UDim.new(0, 4)
        kCorner.Parent = keyBadge

        -- Title
        local title = Instance.new("TextLabel")
        title.Name = "Title"
        title.Size = UDim2.new(1, -16, 0, 20)
        title.Position = UDim2.new(0, 8, 0, 30)
        title.BackgroundTransparency = 1
        title.Font = Enum.Font.GothamBold
        title.TextSize = 12
        title.TextColor3 = Color3.fromRGB(255, 255, 255)
        title.TextXAlignment = Enum.TextXAlignment.Left
        title.TextTruncate = Enum.TextTruncate.AtEnd
        title.Text = def.DisplayName
        title.Parent = card

        -- Description
        local desc = Instance.new("TextLabel")
        desc.Name = "Description"
        desc.Size = UDim2.new(1, -16, 0, 24)
        desc.Position = UDim2.new(0, 8, 0, 48)
        desc.BackgroundTransparency = 1
        desc.Font = Enum.Font.Gotham
        desc.TextSize = 9
        desc.TextColor3 = Color3.fromRGB(160, 170, 190)
        desc.TextWrapped = true
        desc.TextXAlignment = Enum.TextXAlignment.Left
        desc.TextYAlignment = Enum.TextYAlignment.Top
        desc.Text = def.Description
        desc.Parent = card

        -- Progress bar track
        local progBar = Instance.new("Frame")
        progBar.Name = "ProgressBar"
        progBar.Size = UDim2.new(1, -16, 0, 4)
        progBar.Position = UDim2.new(0, 8, 0, 78)
        progBar.BackgroundColor3 = Color3.fromRGB(35, 40, 50)
        progBar.BorderSizePixel = 0
        progBar.Parent = card

        local progFill = Instance.new("Frame")
        progFill.Name = "Fill"
        progFill.Size = UDim2.new(1, 0, 1, 0)
        progFill.BackgroundColor3 = Color3.fromRGB(46, 204, 113)
        progFill.BorderSizePixel = 0
        progFill.Parent = progBar

        -- Status Pill / Cooldown Text
        local statusBadge = Instance.new("TextLabel")
        statusBadge.Name = "StatusBadge"
        statusBadge.Size = UDim2.new(0, 60, 0, 20)
        statusBadge.Position = UDim2.new(0, 8, 0, 88)
        statusBadge.BackgroundColor3 = Color3.fromRGB(20, 60, 35)
        statusBadge.Font = Enum.Font.GothamBold
        statusBadge.TextSize = 10
        statusBadge.TextColor3 = Color3.fromRGB(46, 204, 113)
        statusBadge.Text = "READY"
        statusBadge.Parent = card
        local sCorner = Instance.new("UICorner")
        sCorner.CornerRadius = UDim.new(0, 4)
        sCorner.Parent = statusBadge

        local cdText = Instance.new("TextLabel")
        cdText.Name = "CooldownText"
        cdText.Size = UDim2.new(0, 60, 0, 20)
        cdText.Position = UDim2.new(1, -68, 0, 88)
        cdText.BackgroundTransparency = 1
        cdText.Font = Enum.Font.GothamMedium
        cdText.TextSize = 10
        cdText.TextColor3 = Color3.fromRGB(150, 160, 175)
        cdText.TextXAlignment = Enum.TextXAlignment.Right
        cdText.Text = string.format("%ds CD", def.Cooldown)
        cdText.Parent = card

        -- Click connection
        card.MouseButton1Click:Connect(function()
            if TrapClientController then
                TrapClientController.RequestActivation(trapId)
            end
        end)

        trapCards[trapId] = {
            Card = card,
            Title = title,
            Description = desc,
            StatusBadge = statusBadge,
            CooldownText = cdText,
            ProgressBar = progBar,
            ProgressFill = progFill,
            Stroke = cardStroke,
            Icon = icon,
        }
    end
end

